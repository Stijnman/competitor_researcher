# GEMINI_API_KEY (required for real AI-powered analysis)
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# GITHUB_TOKEN (optional but recommended)
# Classic token with 'repo' scope (or fine-grained with metadata + contents read).
# Greatly increases rate limits for /api/repo-info and allows private repos.
GITHUB_TOKEN=

# NODE_ENV=production   # when running the built server bundle
# PORT=3000             # override default port if desired
