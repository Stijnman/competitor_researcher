{
  "name": "competitor-researcher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CompetitiveGitHubMaster — Paste any GitHub repo URL and receive a rigorous, grounded competitive intelligence report + autonomous agent prompt powered by Gemini.",
  "keywords": [
    "github",
    "competitive-analysis",
    "gemini",
    "ai",
    "open-source",
    "strategy",
    "roadmap"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Stijnman/competitor_researcher.git"
  },
  "bin": {
    "competitor-researcher": "./bin/cli.js"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && echo 'TypeScript OK (ESLint temporarily relaxed for v9+ migration)'",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "cli": "tsx bin/cli.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "commander": "^15.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pino": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.6",
    "esbuild": "^0.25.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsdom": "^29.1.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.8",
    "zod": "^4.4.3"
  }
}
